+		else{
+			RT_TRACE(_module_rtl871x_security_c_,_drv_err_,("rtw_aes_encrypt: stainfo==NULL!!!\n"));
+			DBG_871X("%s, psta==NUL\n", __func__);
+			res=_FAIL;
+		}
+*/
+	}
+
+
+
+_func_exit_;
+		return res;
