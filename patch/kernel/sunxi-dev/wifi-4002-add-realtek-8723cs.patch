+static void ro_ch_timer_process (struct timer_list *t)
+{
+	_adapter *adapter = from_timer(adapter, t,
+						  cfg80211_wdinfo.remain_on_ch_timer);
+	struct rtw_wdev_priv *pwdev_priv = adapter_wdev_data(adapter);
