+			{
+				if (WaitCount <= 2)
+					m++; // 避免一直在兩個level中來回
+				else
+					m = 1;
+
+				if ( m >= 20) //m 最大值 = 20 ' 最大120秒 recheck是否調整 WiFi duration.
+					m = 20;
+
+				n = 3*m;
+				up = 0;
+				dn = 0;
+				WaitCount = 0;
+				result = -1; 
+				RT_TRACE(COMP_COEX, DBG_TRACE, ("[BTCoex], Decrease wifi duration for retryCounter<3!!\n"));
+			}
+		}
+		else  //retry count > 3, 只要1次 retry count > 3, 則調窄WiFi duration
