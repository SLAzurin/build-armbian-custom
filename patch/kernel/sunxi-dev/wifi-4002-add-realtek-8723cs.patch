+void halbtc8821aCsr2ant_sw_mechanism1(IN struct btc_coexist *btcoexist,
+		      IN boolean shrink_rx_lpf, IN boolean low_penalty_ra,
+		      IN boolean limited_dig, IN boolean bt_lna_constrain)
+{
