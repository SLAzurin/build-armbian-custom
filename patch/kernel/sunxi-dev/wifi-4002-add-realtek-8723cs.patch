+VOID
+odm_EVM_FastAntTrainingCallback(struct timer_list *t)
+{
+	PDM_ODM_T *pDM_Odm =
+		from_timer(pDM_Odm, t, DM_SWAT_Table.EVM_FastAntTrainingTimer);
