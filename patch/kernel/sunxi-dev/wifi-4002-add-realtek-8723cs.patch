+BOOLEAN
+GetU1ByteIntegerFromStringInDecimal(
+	IN		char*	Str,
+	IN OUT	u8*		pInt
+	)
+{
+	u16 i = 0;
+	*pInt = 0;
+
+	while ( Str[i] != '\0' )
+	{
+		if ( Str[i] >= '0' && Str[i] <= '9' )
+		{
+			*pInt *= 10;
+			*pInt += ( Str[i] - '0' );
+		}
+		else
+		{
+			return _FALSE;
+		}
+		++i;
+	}
+
+	return _TRUE;
+}
