+	if ( _rtw_memcmp( wrqu->data.pointer, "ip", 2 ) )
+		rtw_tdls_getip( dev, info, wrqu, extra );
+	else if (_rtw_memcmp(wrqu->data.pointer, "port", 4))
+		rtw_tdls_getport( dev, info, wrqu, extra );
