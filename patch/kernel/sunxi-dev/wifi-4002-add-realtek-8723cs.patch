+void rtw_dfs_master_timer_hdl(struct timer_list *t)
+{
+	_adapter *adapter =
+		from_timer(adapter, t, pmlmepriv->dfs_master_timer);
+
+	rtw_dfs_master_cmd(adapter, _TRUE);
+}
