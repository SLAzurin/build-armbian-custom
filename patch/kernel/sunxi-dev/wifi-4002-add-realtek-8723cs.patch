+#define REG_RXDMA_MODE_CTRL_8188F		0x0290
+
+//-----------------------------------------------------
+//
+//	0x0300h ~ 0x03FFh	PCIe
+//
+//-----------------------------------------------------
+#define	REG_PCIE_CTRL_REG_8188F		0x0300
