+	SET_TX_DESC_PKT_SIZE_8703B(pTmp_buffer, modify_ram_size - TXDESC_SIZE);
+	SET_TX_DESC_OFFSET_8703B(pTmp_buffer, TXDESC_SIZE);
+#endif
+	rtl8703b_cal_txdesc_chksum((struct tx_desc*)pTmp_buffer);
