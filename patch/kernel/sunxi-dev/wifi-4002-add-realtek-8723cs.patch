+int rtw_mp_disable_bt_coexist(struct net_device *dev,
+							  struct iw_request_info *info,
+							  union iwreq_data *wrqu, char *extra)
+{
+	PADAPTER padapter = (PADAPTER)rtw_netdev_priv(dev);
