+
+	/* Due to SDIO can not send 32K packet */
+	if (FW_DOWNLOAD_SIZE_8703B == length) {
+		length--;
+	}
+
+	modify_ram_size = length << 2;
+	pTx_data_buffer = rtw_zmalloc(modify_ram_size);
+	
+	if (NULL == pTx_data_buffer) {
+		DBG_871X("Allocate buffer fail!!\n");
